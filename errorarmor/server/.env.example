NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/errorarmor
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
MAX_FILES=5000
MAX_UNZIPPED_MB=150
SCAN_TIMEOUT_SEC=120
QUEUE_CONCURRENCY=2
